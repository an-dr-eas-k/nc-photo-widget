<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A rounded card on the tinted page background. -->
    <style name="SettingsCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="cardCornerRadius">24dp</item>
    </style>

    <!-- Colours of what can be tapped: the brand blue, or the system accent on Android 12+ (see colors.xml). -->
    <style name="ThemeOverlay.NC.Interactive" parent="">
        <item name="colorPrimary">@color/interactive</item>
        <item name="colorOnPrimary">@color/on_interactive</item>
        <item name="colorPrimaryContainer">@color/interactive_container</item>
        <item name="colorOnPrimaryContainer">@color/on_interactive_container</item>
    </style>

    <style name="ThemeOverlay.NC.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/interactive</item>
        <item name="colorOnPrimary">@color/on_interactive</item>
        <item name="colorPrimaryContainer">@color/interactive_container</item>
        <item name="colorOnPrimaryContainer">@color/on_interactive_container</item>
    </style>

    <style name="Widget.NC.Button" parent="Widget.Material3.Button">
        <item name="materialThemeOverlay">@style/ThemeOverlay.NC.Interactive</item>
    </style>

    <style name="Widget.NC.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="materialThemeOverlay">@style/ThemeOverlay.NC.Interactive</item>
    </style>

    <style name="Widget.NC.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="materialThemeOverlay">@style/ThemeOverlay.NC.Interactive</item>
    </style>

    <style name="Widget.NC.LinearProgressIndicator" parent="Widget.Material3.LinearProgressIndicator">
        <item name="materialThemeOverlay">@style/ThemeOverlay.NC.Interactive</item>
    </style>
</resources>
