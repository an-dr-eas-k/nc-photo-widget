<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3, following the system until the user picks light or dark. -->
    <style name="Theme.NC" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryInverse">#9ED4F5</item>
        <item name="colorPrimaryContainer">#CDE5FF</item>
        <item name="colorOnPrimaryContainer">#00344F</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <!-- The brand blue sets the tone; what can be tapped follows the system accent where there is one. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.NC.MaterialAlertDialog</item>
        <item name="materialButtonStyle">@style/Widget.NC.Button</item>
        <item name="checkboxStyle">@style/Widget.NC.CheckBox</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.NC.LinearProgressIndicator</item>
    </style>
</resources>
